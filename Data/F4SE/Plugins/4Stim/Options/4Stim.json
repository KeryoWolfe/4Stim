{
	"_comment": "4Stim's own HUD options, in OStim's options format (docs/OPTIONS.md): a page per actor with undressing, muting, their voice set, and their strap-on, tongue and light (OStim's facelight options) (on / off, and which one). \"state\" (4Stim's) picks the state shown; \"english\" holds the English of the $4stim_ texts (docs/TRANSLATIONS.md).",
	"pages": [
		{
			"name": "4StimActors",
			"description": "$4stim_options_actors",
			"icon": "4Stim/symbols/gender_mf",
			"parent": null
		},
		{
			"name": "4StimActor",
			"description": "$4stim_options_actor",
			"icon": "4Stim/symbols/gender_{sex}",
			"parent": "4StimActors",
			"repeat": "actor"
		},
		{
			"name": "4StimVoice",
			"description": "$4stim_options_voice_page",
			"icon": "4Stim/symbols/switch",
			"parent": "4StimActor"
		},
		{
			"name": "4StimStrapOn",
			"description": "$4stim_options_strap_on_page",
			"icon": "4Stim/sexual/strapon_insert_vert",
			"parent": "4StimActor",
			"sex": "female"
		},
		{
			"name": "4StimTongue",
			"description": "$4stim_options_tongue_page",
			"icon": "4Stim/sensual/kissing",
			"parent": "4StimActor"
		},
		{
			"name": "4StimLight",
			"description": "$4stim_options_light_page",
			"icon": "4Stim/symbols/lightbulb_on",
			"parent": "4StimActor"
		}
	],
	"options": [
		{
			"name": "Undress",
			"page": "4StimActor",
			"state": "stripped",
			"states": {
				"off": {
					"description": "$4stim_options_undress",
					"icon": "4Stim/clothes/bra",
					"function": "FourStimOptions/ToggleUndress"
				},
				"on": {
					"description": "$4stim_options_dress",
					"icon": "4Stim/clothes/top",
					"function": "FourStimOptions/ToggleUndress"
				}
			}
		},
		{
			"name": "Mute",
			"page": "4StimActor",
			"state": "muted",
			"states": {
				"off": {
					"description": "$4stim_options_mute",
					"icon": "4Stim/symbols/x",
					"function": "FourStimOptions/ToggleMute"
				},
				"on": {
					"description": "$4stim_options_unmute",
					"icon": "4Stim/sensual/kissing",
					"border": "ff0000",
					"function": "FourStimOptions/ToggleMute"
				}
			}
		},
		{
			"name": "Voice",
			"page": "4StimVoice",
			"repeat": "voiceSet",
			"states": {
				"default": {
					"description": "$4stim_options_voice_default",
					"icon": "4Stim/symbols/return",
					"function": "FourStimOptions/ChooseVoice"
				},
				"set": {
					"description": "$4stim_options_voice_set",
					"icon": "4Stim/sensual/kissing",
					"border": "ffff00",
					"function": "FourStimOptions/ChooseVoice"
				}
			}
		},
		{
			"name": "Strap-on",
			"page": "4StimStrapOn",
			"repeat": "equipObject",
			"equipType": "strapon",
			"states": {
				"toggle": {
					"description": "$4stim_options_strap_on_toggle",
					"icon": "4Stim/sexual/strapon_insert_hz",
					"function": "FourStimOptions/ToggleStrapOn"
				},
				"object": {
					"description": "$4stim_options_wear_object",
					"icon": "4Stim/sexual/strapon_insert_vert",
					"border": "ffff00",
					"function": "FourStimOptions/ChooseStrapOn"
				}
			}
		},
		{
			"name": "Tongue",
			"page": "4StimTongue",
			"repeat": "equipObject",
			"equipType": "tongue",
			"states": {
				"toggle": {
					"description": "$4stim_options_tongue_toggle",
					"icon": "4Stim/sensual/kissing",
					"function": "FourStimOptions/ToggleTongue"
				},
				"object": {
					"description": "$4stim_options_wear_object",
					"icon": "4Stim/sensual/kissing_end",
					"border": "ffff00",
					"function": "FourStimOptions/ChooseTongue"
				}
			}
		},
		{
			"name": "Light",
			"page": "4StimLight",
			"repeat": "equipObject",
			"equipType": "light",
			"states": {
				"toggle": {
					"description": "$4stim_options_light_toggle",
					"icon": "4Stim/symbols/lightbulb_off",
					"function": "FourStimOptions/ToggleLight"
				},
				"object": {
					"description": "$4stim_options_wear_object",
					"icon": "4Stim/symbols/lightbulb_on",
					"border": "ffff00",
					"function": "FourStimOptions/ChooseLight"
				}
			}
		}
	],
	"english": {
		"$4stim_options_actors": "Actors",
		"$4stim_options_actor": "{actor}",
		"$4stim_options_strap_on_page": "Strap-on",
		"$4stim_options_tongue_page": "Tongue",
		"$4stim_options_undress": "Undress {actor}",
		"$4stim_options_dress": "Dress {actor}",
		"$4stim_options_mute": "Mute {actor}",
		"$4stim_options_unmute": "Unmute {actor}",
		"$4stim_options_strap_on_toggle": "Strap-on on / off for {actor}",
		"$4stim_options_tongue_toggle": "Tongue on / off for {actor}",
		"$4stim_options_wear_object": "Wear {type}",
		"$4stim_options_voice_page": "Voice",
		"$4stim_options_voice_default": "{type} voice for {actor}",
		"$4stim_options_voice_set": "Voice: {type}",
		"$4stim_options_light_page": "Light",
		"$4stim_options_light_toggle": "Light on / off for {actor}"
	}
}
