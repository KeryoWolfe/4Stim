	"english": {
		"$4Stim_OptActors": "Actors",
		"$4Stim_OptActor": "{actor}",
		"$4Stim_OptStrapOnPage": "Strap-on",
		"$4Stim_OptTonguePage": "Tongue",
		"$4Stim_OptUndress": "Undress {actor}",
		"$4Stim_OptDress": "Dress {actor}",
		"$4Stim_OptMute": "Mute {actor}",
		"$4Stim_OptUnmute": "Unmute {actor}",
		"$4Stim_OptStrapOnToggle": "Strap-on on / off for {actor}",
		"$4Stim_OptTongueToggle": "Tongue on / off for {actor}",
		"$4Stim_OptWearObject": "Wear {type}"
	}
