package
{
	import flash.display.GradientType;
	import flash.display.MovieClip;
	import flash.display.Shape;
	import flash.filters.BevelFilter;
	import flash.filters.DropShadowFilter;
	import flash.geom.Matrix;

	// The logo on 4Stim's MCM page (MCMLib.as): 4StimMCMLogo.png redrawn as
	// vector art, because MCM's image control takes vector art only. Three
	// layers traced from the picture (the silver plate, frame and letters;
	// the "4"; the gear and heart), each filled with a gradient sampled from
	// it, with Flash bevels and shadows for the picture's embossing. Made by
	// tools/trace-mcm-logo.py; FourStimLogoBitmap is the picture itself.
	//
	// MCM's image control has no "align" and puts the image at the left of
	// the row, so the logo sits in the middle of a clear box as wide as the
	// row's text area (measured from the page's centered title). Off center?
	// Change ROW_WIDTH (MCM's stage units, 1280x720).
	public class FourStimLogo extends MovieClip
	{
		public static const ROW_WIDTH:Number = 664;
		public static const LOGO_WIDTH:Number = 600;
		private static const ART_WIDTH:Number = 640.0;   // the data's own size
		private static const ART_HEIGHT:Number = 229.0;

		public function FourStimLogo()
		{
			super();
			var scale:Number = LOGO_WIDTH / ART_WIDTH;
			graphics.beginFill(0, 0);
			graphics.drawRect(0, 0, ROW_WIDTH, ART_HEIGHT * scale + 12);
			graphics.endFill();

			var art:MovieClip = new MovieClip();
			art.scaleX = art.scaleY = scale;
			art.x = (ROW_WIDTH - LOGO_WIDTH) / 2;
			addChild(art);

			var bevel:BevelFilter = new BevelFilter(3, 45, 0xFFFFFF, 0.9, 0x000000, 0.45, 5, 5, 1, 2, "inner");
			var silver:Shape = layer(SILVER, 7.7, 46.7, 430.7, 145.3, [0xBEBEBE, 0xCDCFD0, 0xCBCACB, 0xCDCDCE, 0xD1D1D3, 0xCDCDCD, 0xD7D7D7, 0xD0D0D0], [1, 1, 1, 1, 1, 1, 1, 1], [16, 48, 80, 112, 143, 175, 207, 239]);
			silver.filters = [bevel];
			var four:Shape = layer(FOUR, 31.3, 52.7, 100.0, 133.0, [0x696E95, 0x81709F, 0x946C98, 0xB0658D, 0xCE5D81, 0xE1587A], [1, 1, 1, 1, 1, 1], [21, 64, 106, 149, 191, 234]);
			four.filters = [bevel, new DropShadowFilter(4, 45, 0x000000, 0.6, 8, 8, 1, 2)];
			var gear:Shape = layer(GEAR, 419.7, 6.0, 216.7, 216.7, [0x7482B0, 0x837FA9, 0xA0779F, 0xB97195, 0xD96989, 0xE76583], [1, 1, 1, 1, 1, 1], [21, 64, 106, 149, 191, 234]);
			gear.filters = [bevel];
			art.addChild(silver);
			art.addChild(four);
			art.addChild(gear);
			art.filters = [new DropShadowFilter(3, 45, 0x000000, 0.5, 6, 6, 1, 2)];
		}

		// One layer: its outlines filled with a gradient from the bottom left
		// of its box (x, y, w, h) to the top right, as the picture's.
		private static function layer(a_path:Array, a_x:Number, a_y:Number, a_w:Number, a_h:Number,
			a_colors:Array, a_alphas:Array, a_ratios:Array):Shape
		{
			var s:Shape = new Shape();
			var m:Matrix = new Matrix();
			m.createGradientBox(a_w, a_h, -Math.atan2(a_h, a_w), a_x, a_y);
			s.graphics.beginGradientFill(GradientType.LINEAR, a_colors, a_alphas, a_ratios, m);
			LogoArt.drawPath(s.graphics, a_path);
			s.graphics.endFill();
			return s;
		}

